# Database - Railway PostgreSQL reference variable
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10

# Dashboard authentication
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_HOURS=8
CORS_ORIGINS=http://localhost:5173,https://boss-edi-frontend-production.up.railway.app

# GEX inbound HTTPS authentication. Confirm the header and method with GEX.
GEX_INBOUND_TOKEN=replace-after-gex-confirms-authentication
GEX_INBOUND_TOKEN_HEADER=x-edi-token
GEX_ALLOWED_IPS=
EDI_MAX_BYTES=2097152

# Outbound 997 transport. Keep manual until GEX supplies the approved URL/auth.
OUTBOUND_MODE=manual
GEX_OUTBOUND_URL=
GEX_OUTBOUND_TOKEN=
GEX_OUTBOUND_TOKEN_HEADER=authorization
GEX_OUTBOUND_TOKEN_SCHEME=Bearer
OUTBOUND_TIMEOUT_MS=30000
OUTBOUND_POLL_MS=15000
OUTBOUND_MAX_ATTEMPTS=8

# EDI identity
EDI_COMPANY_NAME=Ray Land Inc. DBA Land Logistics
RAY_ISA_ID=3863629312
RAY_ISA_QUALIFIER=12
ENABLE_856=false

# Environment
NODE_ENV=development
PORT=3000
